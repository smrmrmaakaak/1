  "segments": [
    {
      "start": 0.0,
      "end": 2.04,
      "text": " 이른 새벽"
    },
    {
      "start": 5.58,
      "end": 6.98,
      "text": " 이곳은"
    },
    {
      "start": 6.98,
      "end": 7.04,
      "text": " 이곳은"
    },
    {
      "start": 16.64,
      "end": 18.04,
      "text": " 이곳은"
    },
    {
      "start": 78.04,
      "end": 81.64,
      "text": " 다시 보면 돼"
    },
    {
      "start": 82.86,
      "end": 88.36,
      "text": " 친구의 눈물 한 방울의 세상은 갑자기 커지고"
    },
    {
      "start": 88.36,
      "end": 93.92,
      "text": " 내가 못 가진 것보다 지켜야 할 게 더 많아져"
    },
    {
      "start": 93.92,
      "end": 99.02,
      "text": " 어른들은 자꾸 말하지 참아야 큰다고"
    },
    {
      "start": 99.02,
      "end": 104.34,
      "text": " 근데 가끔은 울고 나서 더 멀리 보는 법도 있어"
    },
    {
      "start": 104.34,
      "end": 107.62,
      "text": " 조금 느려도 돼 돌아가도 돼"
    },
    {
      "start": 107.62,
      "end": 115.7,
      "text": " 부서진 마음도 길이 될 수 있어"
    },
    {
      "start": 115.7,
      "end": 120.14,
      "text": " 날아가 종이 비행기야"
    },
    {
      "start": 120.14,
      "end": 122.58,
      "text": " 바람이 안 도와줘도"
    },
    {
      "start": 122.58,
      "end": 126.68,
      "text": " 구겨진 마음도 끝내는 펼쳐져"
    },
    {
      "start": 126.68,
      "end": 130.82,
      "text": " 날아가 종이 비행기야"
    },
    {
      "start": 130.82,
      "end": 133.32,
      "text": " 높이만 이 답은 아냐"
    },
    {
      "start": 133.32,
      "end": 139.24,
      "text": " 떨어진 자리에서 다시 보면 돼"
    },
    {
      "start": 139.24,
      "end": 140.48,
      "text": " ..."
    },
    {
      "start": 151.14,
      "end": 152.54,
      "text": " ..."
    },
    {
      "start": 160.88,
      "end": 163.66,
      "text": " 모든 별이 길은 아니야"
    },
    {
      "start": 163.66,
      "end": 164.62,
      "text": " 몸 taxes"
    },
    {
      "start": 164.62,
      "end": 171.44,
      "text": " 집도 아니고 가장 작은 손길 하나가"
    },
    {
      "start": 171.44,
      "end": 173.86,
      "text": " 어두운 밤을 밝혀"
    },
    {
      "start": 173.86,
      "end": 177.98,
      "text": " 날아가 종이 비행기야"
    },
    {
      "start": 177.98,
      "end": 180.58,
      "text": " 바람이 방해해도"
    },
    {
      "start": 180.58,
      "end": 184.8,
      "text": " 구겨진 마음도 끝내는 펼쳐져"
    },
    {
      "start": 184.8,
      "end": 188.9,
      "text": " 날아가 종이 비행기야"
    },
    {
      "start": 188.9,
      "end": 191.4,
      "text": " 높이만 이 답은 아냐"
    },
    {
      "start": 191.4,
      "end": 195.96,
      "text": " 떨어진 자리에서 다시 보면"
    },
    {
      "start": 195.96,
      "end": 200.08,
      "text": " 날아가 조이 비행기야"
    },
    {
      "start": 200.08,
      "end": 202.82,
      "text": " 우린 아직 가는 중"
    },
    {
      "start": 202.82,
      "end": 204.58,
      "text": " 작은 꿈의 끝에"
    },
    {
      "start": 204.58,
      "end": 208.96,
      "text": " 그 마음이 피어"
    },
    {
      "start": 221.4,
      "end": 223.1,
      "text": " 다음 영상에서 만나요!"
    }
  ],
